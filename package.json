{
  "name": "booksy-biz-mcp",
  "version": "0.3.1",
  "description": "Booksy MCP server: Booksy Biz calendar, clients, staff and payments for Claude Code, Codex and Claude Desktop, through your own logged-in Chrome tab.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.PiotrZapolski/booksy-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiotrZapolski/booksy-mcp.git"
  },
  "bin": {
    "booksy-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "extension/dist",
    "server.json",
    "README.md",
    "README.pl.md",
    "INSTALL.md",
    "LICENSE",
    "docs/endpoints.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "0.3.8",
    "@types/node": "26.6.10",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "booksy",
    "booksy-biz",
    "salon",
    "barbershop",
    "claude",
    "codex",
    "chrome-extension",
    "booksy-mcp",
    "booksy-api",
    "booksy-mcp-server",
    "mcp-server",
    "claude-code",
    "appointment-scheduling"
  ],
  "homepage": "https://piotrzapolski.com/booksy-mcp/",
  "bugs": {
    "url": "https://github.com/PiotrZapolski/booksy-mcp/issues"
  }
}

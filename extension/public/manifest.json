{
  "manifest_version": 3,
  "name": "Booksy MCP Bridge",
  "version": "0.1.0",
  "description": "Lets your local MCP server read your Booksy Biz panel through your own logged-in tab.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://booksy.com/pro/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Booksy MCP Bridge" }
}
